# Local development (docker compose up)
SUPABASE_URL=http://localhost:3000
SUPABASE_KEY=local-dev
SUPABASE_ANON_KEY=local-dev
SUPABASE_JWT_SECRET=local-dev-secret
LEDGER_USER_ID=
ALLOWED_ORIGINS=*
META_ACCESS_TOKEN=
META_FACEBOOK_PAGE_ID=
META_INSTAGRAM_USER_ID=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_TOKEN_ENCRYPTION_KEY=

# Production (Supabase cloud)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_KEY=<service-role-key>             (Settings → API Keys → Legacy → service_role)
# SUPABASE_ANON_KEY=<anon-key>                (Settings → API Keys → Legacy → anon)
# SUPABASE_JWT_SECRET=<jwt-secret>            (Settings → JWT Keys → JWT Secret)
# LEDGER_USER_ID=<your-supabase-user-uuid>    (Authentication → Users)
# ALLOWED_ORIGINS=https://yourapp.lovable.app
# META_ACCESS_TOKEN=<meta-page-access-token>        (for Facebook/Instagram posting)
# META_FACEBOOK_PAGE_ID=<facebook-page-id>
# META_INSTAGRAM_USER_ID=<instagram-business-user-id>
# STRAVA_CLIENT_ID=<strava-api-client-id>           (for Bikes' Strava sync)
# STRAVA_CLIENT_SECRET=<strava-api-client-secret>
# STRAVA_TOKEN_ENCRYPTION_KEY=<random-strong-secret> (pgp_sym_encrypt key, keep out of the DB)
