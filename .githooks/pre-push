#!/bin/sh
# Pre-push checks mirroring CI's build-test and lint jobs, so a broken
# build or a new lint issue is caught before it reaches GitHub Actions.
# Enable once per clone with:
#   git config core.hooksPath .githooks

set -e

echo "pre-push: go build"
go build ./...

echo "pre-push: go vet"
go vet ./...

echo "pre-push: go test"
go test ./...

# Prefer a golangci-lint built for this repo's Go version over whatever
# else might be first on PATH (e.g. an editor/LSP-managed install can be
# older and refuse to even load the config).
LINT_BIN=""
for candidate in "$(go env GOBIN)/golangci-lint" "$(go env GOPATH)/bin/golangci-lint" "$(command -v golangci-lint 2>/dev/null)"; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
        LINT_BIN="$candidate"
        break
    fi
done

if [ -n "$LINT_BIN" ]; then
    base="origin/main"
    git fetch -q origin main 2>/dev/null || true
    echo "pre-push: golangci-lint (new issues since $base)"
    if ! "$LINT_BIN" run --new-from-rev="$base" ./...; then
        echo "pre-push: could not run lint cleanly (version mismatch or real issues above)."
        echo "pre-push: to install a matching version: go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest"
        echo "pre-push: to skip this check for this push: git push --no-verify (not recommended)"
        exit 1
    fi
else
    echo "pre-push: golangci-lint not found, skipping lint check (CI will still run it)"
    echo "pre-push: install with: go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest"
fi

echo "pre-push: all checks passed"
